# Copy this file to .env on the Oracle VM. Never commit the real .env.
API_DOMAIN=api.example.com
STOREFRONT_URL=https://your-storefront.vercel.app
CORS_ORIGINS=https://your-storefront.vercel.app,https://www.example.com

POSTGRES_PASSWORD=replace-with-a-long-random-password
COOKIE_SECRET=replace-with-a-different-long-random-secret
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-admin-password

# Use true only while creating a brand-new database, then change it to false.
DB_SYNCHRONIZE=true
