# Runtime
APP_ENV=production
PORT=3000

# Authentication -- use distinct, strong values in production
COOKIE_SECRET=replace-with-a-long-random-string
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL
# For Docker Compose on an Oracle VM, this is supplied by docker-compose.oracle.yml.
# For another provider, replace the values below with its connection string.
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@db:5432/tanaura
DATABASE_SSL=false
# Set true only for the first empty database startup. Set false afterwards.
DB_SYNCHRONIZE=false

# Public URLs (no trailing slash)
PUBLIC_URL=https://api.example.com
STOREFRONT_URL=https://your-storefront.vercel.app
# Include every browser origin allowed to call the API, comma separated.
CORS_ORIGINS=https://your-storefront.vercel.app,https://www.example.com

# Persist uploaded product images outside the application container
ASSET_UPLOAD_DIR=/data/assets
ASSET_URL_PREFIX=https://api.example.com/assets/

# Optional SMTP email
# EMAIL_FROM="Tanaura Leather & Safety Gloves" <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
